# Copy to conf/site.env and edit. conf/site.env is ignored by Git.

# Writable runtime storage. Do not use a small quota-limited home directory.
PROJECT=/project/xxx/wgbs-pilot

# Module names on this Slurm cluster. Leave a value empty when the executable
# is already available in PATH and no environment module is needed.
JAVA_MODULE=java/jdk-18.0.1.1
CONTAINER_MODULE=singularity/4.0.3

# Use singularity or apptainer on Slurm HPC systems.
CONTAINER_PROFILE=singularity

# Validated workflow versions.
NEXTFLOW_VERSION=25.10.7
METHYLSEQ_VERSION=4.2.0

# Absolute path to the Nextflow launcher.
NEXTFLOW_BIN=/project/xxx/wgbs-pilot/bin/nextflow

