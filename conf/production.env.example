# Copy to conf/production.env only after production storage is assigned.

# Root for production work, results, logs, caches, and temporary files.
PROJECT=/storage/xxx/wgbs-methylseq-production

# Local environment modules. Leave empty when the executable is already in PATH.
JAVA_MODULE=java/jdk-18.0.1.1
CONTAINER_MODULE=singularity/4.0.3
CONTAINER_PROFILE=singularity

# Validated workflow versions.
NEXTFLOW_VERSION=25.10.7
METHYLSEQ_VERSION=4.2.0

# The launcher may live outside PROJECT, but it must be an absolute path.
NEXTFLOW_BIN=/absolute/path/to/bin/nextflow
